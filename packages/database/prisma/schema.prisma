// ─────────────────────────────────────────────
// GoSumo — Prisma Schema
// Single source of truth for the PostgreSQL database.
// Run `pnpm --filter @gosumo/database generate` after any change.
// ─────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // pg_trgm backs the GIN indexes on the free-text search columns
  // (messages.text_content, conversations.subject/current_topic,
  // clients.name/email/phone). Those searches are `ILIKE '%term%'`, which no
  // btree index can serve — see migration 0034.
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, pgTrgm(map: "pg_trgm")]
}

