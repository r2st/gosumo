}

/// The corridor-pattern metrics computed by the micro-market intelligence layer
/// (L1, blueprint §18). Each row in realty_intelligence_aggregates carries one of
/// these; the JSONB metric_value shape is metric-specific (see the module CLAUDE.md).
enum IntelligenceMetricType {
  CADENCE_CONVERSION // which follow-up timing converts, by corridor
  OBJECTION_FREQUENCY // recurring objections, by project/config type
  PRICE_ELASTICITY // realistic budget bands, by locality
  SOURCE_QUALITY // downstream quality of each lead source
  SEASONAL_VELOCITY // lead inflow + conversion curve, by month
}

