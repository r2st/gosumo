// PLATFORM LAYER
// ─────────────────────────────────────────────

/// A GoSumo tenant — a small business using the platform.
model businesses {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String  @db.VarChar(255)
  /// URL-safe identifier, immutable after creation
  slug        String  @unique @db.VarChar(100)
  email       String  @unique @db.VarChar(320)
  phone       String? @db.VarChar(20)
  /// ISO 3166-1 alpha-2
  country     String  @default("IN") @db.Char(2)
  timezone    String  @default("Asia/Kolkata") @db.VarChar(50)
  /// ISO 4217
  currency    String  @default("INR") @db.Char(3)
  logo_url    String? @db.Text
  website_url String? @db.Text

  plan        String @default("starter") @db.VarChar(50)
  /// {maxTeamMembers, maxConversations, maxCampaigns, ...}
  plan_limits Json   @default("{}") @db.JsonB

  /// AI autonomy thresholds and personality settings
  ai_settings Json @default("{}") @db.JsonB
  /// Business profile text used as AI context
  profile     Json @default("{}") @db.JsonB

  /// Guided onboarding wizard state — per-step status (pending/completed/skipped),
  /// collected step data, current step, and completion timestamp. Owned by the
  /// onboarding module (see apps/api/src/modules/onboarding).
  onboarding_progress Json @default("{}") @db.JsonB

  is_active           Boolean   @default(true)
  /// Consent to contribute anonymized corridor patterns to the micro-market
  /// intelligence layer (L1). Off by default (DPDPA purpose-limitation); the
  /// nightly aggregator reads ONLY businesses where this is true.
  intelligence_opt_in Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  // Relations
  team_members                   team_members[]
  clients                        clients[]
  channel_accounts               channel_accounts[]
  channel_contacts               channel_contacts[]
  conversations                  conversations[]
  messages                       messages[]
  business_rules                 business_rules[]
  catalog_categories             catalog_categories[]
  catalog_items                  catalog_items[]
  catalog_variants               catalog_variants[]
  catalog_packages               catalog_packages[]
  orders                         orders[]
  payments                       payments[]
  bookings                       bookings[]
  shipments                      shipments[]
  campaigns                      campaigns[]
  notification_templates         notification_templates[]
  notifications                  notifications[]
  notification_preferences       notification_preferences[]
  notification_triggers          notification_triggers[]
  tasks                          tasks[]
  ai_decisions                   ai_decisions[]
  ai_precedents                  ai_precedents[]
  analytics_events               analytics_events[]
  vector_embeddings_metadata     vector_embeddings_metadata[]
  file_uploads                   file_uploads[]
  audit_logs                     audit_logs[]
  webhook_events                 webhook_events[]
  webhook_dead_letters           webhook_dead_letters[]
  shipping_addresses             shipping_addresses[]
  shipping_options               shipping_options[]
  refunds                        refunds[]
  carts                          carts[]
  cart_items                     cart_items[]
  coupons                        coupons[]
  realty_leads                   realty_leads[]
  realty_projects                realty_projects[]
  realty_units                   realty_units[]
  realty_assets                  realty_assets[]
  realty_site_visits             realty_site_visits[]
  realty_message_templates       realty_message_templates[]
  realty_cadences                realty_cadences[]
  realty_cadence_steps           realty_cadence_steps[]
  realty_cadence_enrollments     realty_cadence_enrollments[]
  realty_approvals               realty_approvals[]
  realty_account_settings        realty_account_settings?
  realty_broker_alerts           realty_broker_alerts[]
  realty_conversation_control    realty_conversation_control[]
  realty_dead_letters            realty_dead_letters[]
  realty_migration_runs          realty_migration_runs[]
  realty_autonomy_events         realty_autonomy_events[]
  realty_no_ship_incidents       realty_no_ship_incidents[]
  realty_intelligence_aggregates realty_intelligence_aggregates[]
  realty_syndications            realty_syndications[]
  realty_reliability_scores      realty_reliability_scores[]
  realty_resale_listings         realty_resale_listings[]
  business_subscription          business_subscriptions?
  consent_logs                   consent_logs[]
  realty_compliance_settings     realty_compliance_settings?
  realty_integration_connections realty_integration_connections[]
  realty_eoi_requests            realty_eoi_requests[]
  segments                       segments[]
  canned_responses               canned_responses[]
  sla_policies                   sla_policies[]
  sla_breaches                   sla_breaches[]
  api_keys                       api_keys[]

  @@index([slug])
  @@index([email])
  @@index([is_active, created_at])
  @@index([deleted_at])
  @@map("businesses")
}

/// A human operator who belongs to a business.
model team_members {
  id          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String           @db.Uuid
  email       String           @db.VarChar(320)
  name        String           @db.VarChar(255)
  avatar_url  String?          @db.Text
  role        TeamMemberRole   @default(STAFF)
  status      TeamMemberStatus @default(INVITED)
  phone       String?          @db.VarChar(20)

  /// Hashed password — never stored raw. Null for OAuth-only accounts.
  password_hash String? @db.Text
  /// AES-256 encrypted TOTP secret
  totp_secret   String? @db.Text

  /// Identity provider used to sign in
  auth_provider AuthProvider @default(LOCAL)
  /// Google account subject id (`sub` claim) — set for GOOGLE accounts
  google_id     String?      @unique @db.VarChar(255)
  last_login_at DateTime?    @db.Timestamptz
  login_count   Int          @default(0)

  /// {email, whatsapp, sound, taskAlerts}
  notification_prefs Json @default("{}") @db.JsonB

  invite_token String?   @unique @db.VarChar(64)
  /// FK to team_members (self-referential)
  invited_by   String?   @db.Uuid
  invited_at   DateTime? @db.Timestamptz

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business         businesses         @relation(fields: [business_id], references: [id], onDelete: Cascade)
  inviter          team_members?      @relation("InvitedBy", fields: [invited_by], references: [id])
  invitees         team_members[]     @relation("InvitedBy")
  assigned_tasks   tasks[]            @relation("AssignedTo")
  resolved_tasks   tasks[]            @relation("ResolvedBy")
  audit_logs       audit_logs[]
  canned_responses canned_responses[]
  api_keys         api_keys[]

  @@unique([business_id, email])
  @@index([business_id, status])
  @@index([business_id, role])
  @@index([invite_token])
  // Login resolves a member by email across all tenants, so the leading column
  // of @@unique([business_id, email]) is not available to seek on.
  @@index([email])
  @@map("team_members")
}

/// A client/customer that contacts a business.
model clients {
  id               String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id      String  @db.Uuid
  name             String? @db.VarChar(255)
  email            String? @db.VarChar(320)
  /// E.164 format
  phone            String? @db.VarChar(20)
  avatar_url       String? @db.Text
  consumer_user_id String? @db.Uuid

  /// AI-built enrichment profile
  profile  Json     @default("{}") @db.JsonB
  /// Opt-out status per channel: { "WHATSAPP": true }
  opt_outs Json     @default("{}") @db.JsonB
  /// Free-form contact tags, managed by the `contact` module
  tags     String[] @default([])

  ltv_score         Decimal?  @db.Decimal(12, 2)
  /// 0.0000–1.0000
  churn_risk        Decimal?  @db.Decimal(5, 4)
  engagement_score  Decimal?  @db.Decimal(5, 4)
  scores_updated_at DateTime? @db.Timestamptz

  total_orders        Int       @default(0)
  total_spent         Decimal   @default(0) @db.Decimal(14, 2)
  last_interaction_at DateTime? @db.Timestamptz

  first_seen_at DateTime  @default(now()) @db.Timestamptz
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
  deleted_at    DateTime? @db.Timestamptz

  business                 businesses                 @relation(fields: [business_id], references: [id], onDelete: Cascade)
  consumer_user            consumer_users?            @relation(fields: [consumer_user_id], references: [id])
  channel_contacts         channel_contacts[]
  conversations            conversations[]
  orders                   orders[]
  bookings                 bookings[]
  payments                 payments[]
  shipping_addresses       shipping_addresses[]
  carts                    carts[]
  analytics_events         analytics_events[]
  notifications            notifications[]
  notification_preferences notification_preferences[]

  @@unique([business_id, phone], map: "uq_clients_business_phone")
  @@unique([business_id, email], map: "uq_clients_business_email")
  @@index([business_id, churn_risk])
  @@index([business_id, ltv_score])
  @@index([business_id, last_interaction_at])
  @@index([consumer_user_id])
  // Contact search is `ILIKE '%term%'` across all three columns at once. Neither
  // uq_clients_business_* index can seek on an unanchored pattern, so the search
  // fell back to scanning the whole table — every tenant's rows, not just the
  // caller's. Trigram GIN turns each arm of the OR into a bitmap scan.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  // `tags` is filtered with hasSome (`tags && ARRAY[...]`), which no btree can
  // serve. Both the contact list and every getSegmentMembers call carry it.
  // See migration 0037 for the measurements.
  @@index([tags], type: Gin)
  @@map("clients")
}

/// Cross-merchant consumer profile (future: one person across multiple businesses).
model consumer_users {
  id    String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone String? @unique @db.VarChar(20)
  email String? @unique @db.VarChar(320)
  name  String? @db.VarChar(255)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  clients clients[]

  @@map("consumer_users")
}

// ─────────────────────────────────────────────
// CHANNEL & MESSAGING LAYER
// ─────────────────────────────────────────────

/// A business's account on a specific messaging channel (e.g. their WhatsApp number).
model channel_accounts {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String      @db.Uuid
  channel     ChannelType
  /// Human label, e.g. "Main WhatsApp"
  name        String      @db.VarChar(255)
  is_primary  Boolean     @default(false)

  /// Phone number ID, IG account ID, etc.
  external_id      String  @db.VarChar(255)
  /// WABA ID, page ID, etc.
  external_account String? @db.VarChar(255)

  /// Encrypted credentials — actual secrets in KMS/Vault
  credentials    Json    @default("{}") @db.JsonB
  webhook_url    String? @db.Text
  /// HMAC secret for signature verification
  webhook_secret String? @db.Text

  is_active    Boolean @default(true)
  is_verified  Boolean @default(false)
  /// {supportsTemplates, supportsInteractive, supportsMedia, supportsVoice}
  capabilities Json    @default("{}") @db.JsonB

  message_limit_per_day Int?
  messages_sent_today   Int       @default(0)
  limit_reset_at        DateTime? @db.Timestamptz

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business               businesses               @relation(fields: [business_id], references: [id], onDelete: Cascade)
  channel_contacts       channel_contacts[]
  conversations          conversations[]
  messages               messages[]
  notification_templates notification_templates[]

  @@unique([business_id, channel, external_id])
  @@index([business_id, channel, is_active])
  // Every inbound webhook resolves its account by (channel, external_id) before
  // any tenant is known — neither index above leads with `channel`.
  @@index([channel, external_id])
  @@map("channel_accounts")
}

/// Maps a channel-specific external ID to an internal client.
model channel_contacts {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String      @db.Uuid
  client_id          String      @db.Uuid
  channel_account_id String      @db.Uuid
  channel            ChannelType

  /// Phone, IG user ID, email, etc.
  external_id     String  @db.VarChar(255)
  display_name    String? @db.VarChar(255)
  profile_pic_url String? @db.Text
  is_opted_in     Boolean @default(true)

  channel_metadata Json @default("{}") @db.JsonB

  first_seen_at DateTime @default(now()) @db.Timestamptz
  last_seen_at  DateTime @default(now()) @db.Timestamptz
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  business        businesses       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client          clients          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  channel_account channel_accounts @relation(fields: [channel_account_id], references: [id])

  @@unique([channel_account_id, external_id])
  @@index([business_id, channel, external_id])
  @@index([client_id])
  @@map("channel_contacts")
}

/// A conversation thread between a client and a business.
model conversations {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String      @db.Uuid
  client_id          String      @db.Uuid
  channel_account_id String      @db.Uuid
  channel            ChannelType

  status ConversationStatus @default(OPEN)

  current_intent    String?  @db.VarChar(100)
  intent_confidence Decimal? @db.Decimal(5, 4)
  current_topic     String?  @db.VarChar(100)

  /// FK to team_members
  assigned_to String? @db.Uuid

  /// Email subject / conversation title
  subject            String? @db.VarChar(500)
  /// Channel's thread ID
  external_thread_id String? @db.VarChar(255)

  first_message_at DateTime? @db.Timestamptz
  last_message_at  DateTime? @db.Timestamptz
  resolved_at      DateTime? @db.Timestamptz
  snoozed_until    DateTime? @db.Timestamptz

  message_count       Int @default(0)
  unread_count        Int @default(0)
  human_message_count Int @default(0)

  /// High-water mark for `messages.sequence` in this conversation.
  ///
  /// Not a duplicate of `message_count`: that one is a denormalized display
  /// tally maintained best-effort, while this is the allocator. A writer claims
  /// the next sequence with `UPDATE ... SET message_seq = message_seq + 1`
  /// inside the same transaction as the message insert, so the row lock
  /// Postgres takes on this row is what serializes two concurrent inserts into
  /// the same conversation.
  message_seq Int @default(0)

  /// 1–5 customer satisfaction score
  csat_score        Int?      @db.Integer
  csat_submitted_at DateTime? @db.Timestamptz

  tags     String[] @default([])
  metadata Json     @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business         businesses         @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client           clients            @relation(fields: [client_id], references: [id])
  channel_account  channel_accounts   @relation(fields: [channel_account_id], references: [id])
  messages         messages[]
  tasks            tasks[]
  ai_decisions     ai_decisions[]
  analytics_events analytics_events[]
  sla_breaches     sla_breaches[]

  @@index([business_id, status, last_message_at(sort: Desc)])
  // The inbox's default view applies no status filter, so the index above
  // cannot serve it — status sits between business_id and the sort column.
  // Without this the most-loaded screen in the product sorted the tenant's
  // entire conversation table on every page load.
  @@index([business_id, last_message_at(sort: Desc)])
  @@index([business_id, client_id])
  @@index([business_id, assigned_to, status])
  @@index([business_id, channel, status])
  @@index([client_id, status])
  // The snooze-wake sweep filters (business_id, status, snoozed_until) and
  // orders by snoozed_until; the status index above stops one column short and
  // left it sorting every snoozed row to return one batch.
  @@index([business_id, status, snoozed_until])
  // Conversation search — same unanchored-ILIKE story as clients.
  @@index([subject(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([current_topic(ops: raw("gin_trgm_ops"))], type: Gin)
  // Inbox tag filter, `tags && ARRAY[...]`. Unindexed it walked the tenant's
  // whole last_message_at index whenever the tag matched nothing recent.
  // See migration 0037 for the measurements.
  @@index([tags], type: Gin)
  @@map("conversations")
}

/// An individual message within a conversation.
/// High-volume table — partitioned by created_at month in production.
model messages {
  id                 String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String @db.Uuid
  conversation_id    String @db.Uuid
  channel_account_id String @db.Uuid

  /// 1-based arrival order within the conversation. The total order.
  ///
  /// `created_at` is Postgres `now()` — the *transaction start* timestamp — so
  /// two messages whose transactions begin in the same microsecond compare
  /// equal, and `(created_at, id)` breaks that tie by a v4 UUID that carries no
  /// time information. Every reader agrees, but on an order that is not the
  /// arrival order. This column is: it is claimed under a row lock on
  /// `conversations.message_seq`, so it reflects the order the writes actually
  /// committed in, and a reader can tell a gap from a tie.
  ///
  /// Deliberately has no default. Prisma makes a defaultless required scalar a
  /// required argument to `create()`, so every write path has to go through the
  /// allocator and `tsc` names the ones that do not.
  sequence Int

  direction MessageDirection
  type      MessageType      @default(TEXT)
  status    MessageStatus    @default(PENDING)

  /// "CLIENT" | "AI" | "HUMAN_AGENT" | "SYSTEM"
  sender_type String  @db.VarChar(20)
  /// client_id or team_member_id
  sender_id   String? @db.Uuid

  /// Polymorphic content payload (TEXT, IMAGE, DOCUMENT, etc.)
  content Json @db.JsonB

  /// Channel-assigned message ID
  external_id     String?   @db.VarChar(255)
  external_status String?   @db.VarChar(50)
  delivered_at    DateTime? @db.Timestamptz
  read_at         DateTime? @db.Timestamptz
  failed_at       DateTime? @db.Timestamptz
  failure_reason  String?   @db.Text

  ai_decision_id   String?  @db.Uuid
  is_ai_generated  Boolean  @default(false)
  confidence_score Decimal? @db.Decimal(5, 4)

  campaign_id String? @db.Uuid

  /// [{emoji, senderId, at}]
  reactions Json @default("[]") @db.JsonB

  /// Extracted text for full-text search (denormalized)
  text_content String? @db.Text

  metadata Json @default("{}") @db.JsonB

  sent_at    DateTime? @db.Timestamptz
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  business        businesses       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  conversation    conversations    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  channel_account channel_accounts @relation(fields: [channel_account_id], references: [id])
  campaign        campaigns?       @relation(fields: [campaign_id], references: [id])
  file_uploads    file_uploads[]

  /// The total order, and the constraint that makes it one. A duplicate claim
  /// cannot exist, so a reader that sorts on this can trust it.
  @@unique([conversation_id, sequence])
  /// One message per (tenant, channel account, channel-assigned id).
  ///
  /// `webhook_events(source, external_id)` already turns a provider's retry
  /// away at the door, but two paths walk around it: a `webhook-dlq` replay
  /// deliberately skips the dedupe wall (a delivery parked *after* it was
  /// recorded would otherwise be discarded as its own duplicate), and the
  /// web-chat socket has no wall at all. This is the backstop at the row that
  /// matters. `external_id` is null for outbound and system messages, and
  /// Postgres treats nulls as distinct in a unique index, so those are
  /// unaffected.
  @@unique([business_id, channel_account_id, external_id])
  @@index([conversation_id, created_at(sort: Desc)])
  @@index([business_id, created_at(sort: Desc)])
  @@index([business_id, sender_type, created_at(sort: Desc)])
  @@index([external_id])
  @@index([campaign_id])
  // Message search. The business_id+created_at index above made a *common*
  // term look cheap — the LIMIT filled before the scan got far. A term that
  // matches nothing (the normal case for a real search box) read the whole
  // table. This is the largest and fastest-growing table in the schema, so it
  // is also where the unindexed scan hurts most.
  @@index([text_content(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("messages")
}

/// Uploaded media and document references (S3-backed).
model file_uploads {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String         @db.Uuid
  message_id  String?        @db.Uuid
  type        FileUploadType
  filename    String         @db.VarChar(500)
  mime_type   String         @db.VarChar(100)
  size_bytes  Int
  /// S3 object key
  storage_key String         @db.Text
  /// Public CDN URL (after processing)
  cdn_url     String?        @db.Text

  width         Int?
  height        Int?
  thumbnail_key String? @db.Text

  is_processed Boolean  @default(false)
  is_public    Boolean  @default(false)
  pii_detected Boolean?

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  message  messages?  @relation(fields: [message_id], references: [id])

  @@index([business_id, type])
  @@index([business_id, created_at])
  @@index([message_id])
  @@index([storage_key])
  @@map("file_uploads")
}

/// Reusable message templates (WhatsApp approved, SMS, email).
model notification_templates {
  id                 String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id        String                      @db.Uuid
  /// null = applies to all accounts of this channel
  channel_account_id String?                     @db.Uuid
  channel            NotificationTemplateChannel
  name               String                      @db.VarChar(255)
  /// WhatsApp approved template name
  external_name      String?                     @db.VarChar(255)

  /// Channel-specific structure
  content   Json @db.JsonB
  variables Json @default("[]") @db.JsonB

  is_approved      Boolean   @default(false)
  /// PENDING | APPROVED | REJECTED
  approval_status  String?   @db.VarChar(50)
  approved_at      DateTime? @db.Timestamptz
  rejection_reason String?   @db.Text

  /// MARKETING | UTILITY | AUTHENTICATION
  category  String? @db.VarChar(50)
  language  String  @default("en") @db.VarChar(10)
  is_active Boolean @default(true)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business        businesses        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  channel_account channel_accounts? @relation(fields: [channel_account_id], references: [id])

  notifications notifications[]

  @@unique([business_id, channel, name])
  @@index([business_id, channel, is_active])
  @@map("notification_templates")
}

/// A single outbound notification dispatch across any channel (email, SMS,
/// WhatsApp, push). Owns delivery tracking, retry bookkeeping, and history.
model notifications {
  id          String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String                      @db.Uuid
  /// The end-client recipient (null for staff/system notifications).
  client_id   String?                     @db.Uuid
  channel     NotificationTemplateChannel
  category    NotificationCategory        @default(TRANSACTIONAL)
  status      NotificationStatus          @default(PENDING)

  /// Template used to render the body (null for ad-hoc/raw notifications).
  template_id String? @db.Uuid
  /// Domain event that triggered this notification, e.g. "booking.reminder".
  event_type  String? @db.VarChar(100)

  /// Resolved destination address: phone (E.164), email, or device token.
  recipient String  @db.VarChar(320)
  /// Email subject / push title — channel dependent, may be null.
  subject   String? @db.VarChar(500)
  /// Rendered, channel-specific payload that was (or will be) sent.
  content   Json    @db.JsonB
  /// Variables supplied to the template at render time.
  data      Json    @default("{}") @db.JsonB

  /// Idempotency key — a unique (business, dedupe_key) prevents double sends.
  dedupe_key  String? @db.VarChar(255)
  /// Groups a bulk/campaign batch together for stats.
  batch_id    String? @db.Uuid
  campaign_id String? @db.Uuid

  attempts     Int @default(0)
  max_attempts Int @default(3)

  /// Provider-assigned message ID (Meta wamid, SMS gateway id, FCM id, etc.).
  provider_message_id String? @db.VarChar(255)
  failure_reason      String? @db.Text

  scheduled_at DateTime? @db.Timestamptz
  queued_at    DateTime? @db.Timestamptz
  sent_at      DateTime? @db.Timestamptz
  delivered_at DateTime? @db.Timestamptz
  read_at      DateTime? @db.Timestamptz
  failed_at    DateTime? @db.Timestamptz

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses              @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client   clients?                @relation(fields: [client_id], references: [id])
  template notification_templates? @relation(fields: [template_id], references: [id])

  @@unique([business_id, dedupe_key], map: "uq_notifications_business_dedupe")
  @@index([business_id, status, created_at(sort: Desc)])
  @@index([business_id, client_id, created_at(sort: Desc)])
  @@index([business_id, channel, status])
  @@index([batch_id])
  @@index([provider_message_id])
  // The stuck-notification sweep runs before a tenant is known — it asks which
  // tenants have stranded rows — so no business_id-leading index can serve it.
  @@index([status, created_at])
  @@map("notifications")
}

/// Per-client opt-in/opt-out preference for a channel (optionally a category).
/// A row with category=null is the channel-wide default for that client.
model notification_preferences {
  id          String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String                      @db.Uuid
  client_id   String                      @db.Uuid
  channel     NotificationTemplateChannel
  /// null = applies to all categories on this channel.
  category    NotificationCategory?
  is_enabled  Boolean                     @default(true)

  /// Optional do-not-disturb window (minutes from local midnight, IST).
  quiet_hours_start Int? @db.SmallInt
  quiet_hours_end   Int? @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client   clients    @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, channel, category], map: "uq_notif_pref_client_channel_category")
  @@index([business_id, client_id])
  @@map("notification_preferences")
}

/// Event-driven trigger: when `event_type` fires, send `template` on `channel`.
model notification_triggers {
  id          String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String                      @db.Uuid
  /// Domain event name, e.g. "order.confirmed", "booking.reminder".
  event_type  String                      @db.VarChar(100)
  channel     NotificationTemplateChannel
  category    NotificationCategory        @default(TRANSACTIONAL)
  template_id String?                     @db.Uuid

  is_active     Boolean @default(true)
  /// Delay before sending after the event fires, in minutes (0 = immediate).
  delay_minutes Int     @default(0)
  /// Optional JSON-path conditions evaluated against the event payload.
  conditions    Json    @default("[]") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, event_type, channel], map: "uq_notif_trigger_business_event_channel")
  @@index([business_id, event_type, is_active])
  @@map("notification_triggers")
}

/// Idempotent log of all incoming webhooks from external systems.
model webhook_events {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// null for platform-level webhooks
  business_id String? @db.Uuid
  /// "WHATSAPP" | "RAZORPAY" | "SHIPROCKET" | ...
  source      String  @db.VarChar(50)
  /// e.g. "messages" | "payment.captured"
  event_type  String  @db.VarChar(100)
  /// Channel-specific event ID for deduplication
  external_id String  @db.VarChar(255)

  payload Json @db.JsonB
  headers Json @default("{}") @db.JsonB

  processed    Boolean   @default(false)
  processed_at DateTime? @db.Timestamptz
  attempts     Int       @default(0)
  error        String?   @db.Text

  signature_valid Boolean @default(false)

  received_at DateTime @default(now()) @db.Timestamptz

  business businesses? @relation(fields: [business_id], references: [id])

  @@unique([source, external_id])
  @@index([source, processed, received_at])
  @@index([business_id, received_at(sort: Desc)])
  @@map("webhook_events")
}

/// An inbound webhook whose handler threw, parked for retry instead of being lost.
///
/// `webhook_events` is the *idempotency* ledger: its unique `[source,
/// external_id]` makes a provider redelivery a no-op. That is exactly why a
/// failed delivery cannot be recovered from it — the provider's own retry is
/// swallowed as a duplicate. This table is the separate *recovery* ledger, with
/// its own attempt counter, backoff schedule, and operator lifecycle.
model webhook_dead_letters {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// null when the failure happened before the tenant could be resolved
  /// (a platform-level gateway webhook whose payment row was unreadable).
  business_id String? @db.Uuid

  /// Loose reference to the `webhook_events` row. Deliberately not a foreign
  /// key: purging the delivery log must never drop a pending recovery.
  webhook_event_id String? @db.Uuid

  /// "WHATSAPP" | "RAZORPAY" | "STRIPE" | ... — also the replayer registry key.
  source      String @db.VarChar(50)
  event_type  String @db.VarChar(100)
  external_id String @db.VarChar(255)

  /// Verbatim provider payload, sufficient to replay without the provider.
  payload Json @db.JsonB
  headers Json @default("{}") @db.JsonB

  error_message String  @db.Text
  error_stack   String? @db.Text

  attempts     Int @default(0)
  max_attempts Int @default(6)

  status          DeadLetterStatus @default(PENDING)
  /// When the next backoff-scheduled retry is due; null once terminal.
  next_retry_at   DateTime?        @db.Timestamptz
  last_attempt_at DateTime?        @db.Timestamptz
  replayed_at     DateTime?        @db.Timestamptz
  resolved_at     DateTime?        @db.Timestamptz
  /// Free-form note captured when a human resolves/discards the entry.
  resolution      String?          @db.Text
  correlation_id  String?          @db.VarChar(64)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses? @relation(fields: [business_id], references: [id], onDelete: Cascade)

  /// One recovery row per provider event — a webhook that fails twice updates
  /// its attempt count rather than stacking duplicates.
  @@unique([source, external_id])
  @@index([status, next_retry_at])
  @@index([business_id, status, created_at(sort: Desc)])
  @@index([business_id, source, event_type])
  @@map("webhook_dead_letters")
}

// ─────────────────────────────────────────────
// INTELLIGENCE LAYER
// ─────────────────────────────────────────────

/// Business rules that constrain AI behaviour (pricing, refunds, working hours, etc.).
model business_rules {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String      @db.Uuid
  type        RuleType
  name        String      @db.VarChar(255)
  description String?     @db.Text
  trigger     RuleTrigger @default(ALWAYS)
  /// Higher = checked first
  priority    Int         @default(0)
  is_active   Boolean     @default(true)

  conditions Json @default("{}") @db.JsonB
  actions    Json @default("{}") @db.JsonB

  /// Denormalized text for RAG indexing in Qdrant
  embedding_text String? @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  // Vector embedding looked up via vector_embeddings_metadata WHERE entity_type='BUSINESS_RULE' AND entity_id=id

  @@index([business_id, type, is_active])
  @@index([business_id, trigger, priority])
  @@map("business_rules")
}

/// Every AI decision — immutable audit trail.
model ai_decisions {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id     String  @db.Uuid
  conversation_id String  @db.Uuid
  /// The triggering inbound message
  message_id      String? @db.Uuid
  /// The HITL task created for review (if any)
  task_id         String? @db.Uuid

  type    AiDecisionType
  outcome AiDecisionOutcome

  /// {actionType, parameters, reasoning, alternativesConsidered}
  proposed_action Json @db.JsonB

  /// 0.0000–1.0000
  confidence_score     Decimal @db.Decimal(5, 4)
  confidence_breakdown Json    @default("{}") @db.JsonB

  model_id          String? @db.VarChar(100)
  prompt_tokens     Int?
  completion_tokens Int?
  latency_ms        Int?

  was_overridden  Boolean @default(false)
  override_by     String? @db.Uuid
  override_reason String? @db.Text
  override_action Json?   @db.JsonB

  seeded_precedent_id String? @db.Uuid

  decided_at  DateTime  @default(now()) @db.Timestamptz
  executed_at DateTime? @db.Timestamptz

  business     businesses      @relation(fields: [business_id], references: [id], onDelete: Cascade)
  conversation conversations   @relation(fields: [conversation_id], references: [id])
  task         tasks?          @relation(fields: [task_id], references: [id])
  precedents   ai_precedents[]

  @@index([business_id, outcome, decided_at(sort: Desc)])
  @@index([conversation_id, decided_at(sort: Desc)])
  @@index([business_id, type, decided_at(sort: Desc)])
  @@index([was_overridden, decided_at(sort: Desc)])
  @@map("ai_decisions")
}

/// Learned patterns from human corrections — fed back into the RAG pipeline.
model ai_precedents {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String @db.Uuid
  /// The ai_decision that was overridden
  decision_id String @db.Uuid

  situation_summary String  @db.Text
  intent            String? @db.VarChar(100)

  ai_action       Json    @db.JsonB
  human_action    Json    @db.JsonB
  human_reasoning String? @db.Text

  /// Negative means AI was overconfident
  confidence_delta Decimal @db.Decimal(5, 4)

  apply_count     Int       @default(0)
  last_applied_at DateTime? @db.Timestamptz

  is_active  Boolean   @default(true)
  expires_at DateTime? @db.Timestamptz

  /// Qdrant vector point ID for this precedent
  qdrant_point_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  decision ai_decisions @relation(fields: [decision_id], references: [id])

  @@index([business_id, intent, is_active])
  @@index([business_id, last_applied_at(sort: Desc)])
  @@map("ai_precedents")
}

/// Tracks documents embedded in Qdrant so the vector store can be managed.
model vector_embeddings_metadata {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String              @db.Uuid
  entity_type EmbeddingEntityType
  /// FK to whichever table (polymorphic)
  entity_id   String              @db.Uuid

  /// e.g. "gosumo_business_<uuid>"
  collection      String @db.VarChar(100)
  qdrant_point_id String @db.Uuid

  /// SHA-256 of embedded text — re-embed when this changes
  content_hash String @db.Char(64)
  /// Embedding model version
  model_id     String @db.VarChar(100)

  embedded_at   DateTime @db.Timestamptz
  needs_reindex Boolean  @default(false)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  // entity_id is a polymorphic FK resolved at application layer using entity_type.
  // No Prisma relations here — queries use: WHERE entity_type = 'X' AND entity_id = uuid.

  @@unique([entity_type, entity_id])
  @@index([business_id, entity_type, needs_reindex])
  @@index([qdrant_point_id])
  @@map("vector_embeddings_metadata")
}

/// HITL task queue — created when AI confidence is below the auto-execute threshold.
model tasks {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id     String  @db.Uuid
  conversation_id String  @db.Uuid
  ai_decision_id  String? @db.Uuid

  type        TaskType
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  title       String       @db.VarChar(500)
  description String?      @db.Text

  assigned_to String?   @db.Uuid
  assigned_at DateTime? @db.Timestamptz

  /// {message, actions, confidence}
  ai_draft Json? @db.JsonB

  resolved_by     String?   @db.Uuid
  resolved_at     DateTime? @db.Timestamptz
  resolution_note String?   @db.Text
  resolution      Json?     @db.JsonB

  due_at          DateTime? @db.Timestamptz
  sla_minutes     Int?
  sla_breached    Boolean   @default(false)
  sla_breached_at DateTime? @db.Timestamptz

  /// FK to parent task (for escalation chains)
  escalated_from   String? @db.Uuid
  escalation_level Int     @default(0)

  metadata Json @default("{}") @db.JsonB

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business     businesses     @relation(fields: [business_id], references: [id], onDelete: Cascade)
  conversation conversations  @relation(fields: [conversation_id], references: [id])
  assignee     team_members?  @relation("AssignedTo", fields: [assigned_to], references: [id])
  resolver     team_members?  @relation("ResolvedBy", fields: [resolved_by], references: [id])
  parent_task  tasks?         @relation("EscalationChain", fields: [escalated_from], references: [id])
  child_tasks  tasks[]        @relation("EscalationChain")
  ai_decisions ai_decisions[]

  @@index([business_id, status, priority, created_at(sort: Desc)])
  @@index([business_id, assigned_to, status])
  @@index([business_id, due_at, status])
  @@index([conversation_id])
  @@map("tasks")
}

// ─────────────────────────────────────────────
// COMMERCE LAYER
// ─────────────────────────────────────────────

/// Product/service catalog categories (tree structure via parent_id).
model catalog_categories {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  /// null = root category
  parent_id   String? @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @db.VarChar(100)
  description String? @db.Text
  image_url   String? @db.Text
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)
  metadata    Json    @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses           @relation(fields: [business_id], references: [id], onDelete: Cascade)
  parent   catalog_categories?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children catalog_categories[] @relation("CategoryTree")
  items    catalog_items[]

  @@unique([business_id, slug])
  @@index([business_id, parent_id, is_active])
  @@map("catalog_categories")
}

/// A product, service, or digital item in the catalog.
model catalog_items {
  id                String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id       String          @db.Uuid
  category_id       String?         @db.Uuid
  type              CatalogItemType @default(PRODUCT)
  name              String          @db.VarChar(500)
  slug              String          @db.VarChar(200)
  description       String?         @db.Text
  short_description String?         @db.VarChar(500)

  price         Decimal  @db.Decimal(12, 2)
  compare_price Decimal? @db.Decimal(12, 2)
  currency      String   @default("INR") @db.Char(3)
  tax_rate      Decimal  @default(0) @db.Decimal(5, 4)
  tax_inclusive Boolean  @default(true)

  sku                 String? @db.VarChar(100)
  barcode             String? @db.VarChar(100)
  stock_quantity      Int?
  track_inventory     Boolean @default(false)
  allow_backorder     Boolean @default(false)
  low_stock_threshold Int?

  weight_grams Int?
  length_cm    Decimal? @db.Decimal(8, 2)
  width_cm     Decimal? @db.Decimal(8, 2)
  height_cm    Decimal? @db.Decimal(8, 2)

  /// [{url, alt, isPrimary}]
  images Json @default("[]") @db.JsonB

  tags String[] @default([])

  /// AI-friendly description for RAG
  ai_description String? @db.Text

  is_active   Boolean @default(true)
  is_featured Boolean @default(false)
  sort_order  Int     @default(0)

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  category catalog_categories? @relation(fields: [category_id], references: [id])
  variants catalog_variants[]
  // Note: vector embedding is looked up via entity_type='CATALOG_ITEM' + entity_id in vector_embeddings_metadata.
  // No Prisma relation here because entity_id is a polymorphic FK shared across multiple entity types.

  @@unique([business_id, slug])
  @@index([business_id, category_id, is_active])
  @@index([business_id, type, is_active])
  @@index([business_id, is_featured, is_active])
  @@map("catalog_items")
}

/// Product variants (size, colour, etc.).
model catalog_variants {
  id          String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String @db.Uuid
  item_id     String @db.Uuid

  name    String  @db.VarChar(255)
  sku     String? @db.VarChar(100)
  barcode String? @db.VarChar(100)

  /// null = inherit from parent item
  price         Decimal? @db.Decimal(12, 2)
  compare_price Decimal? @db.Decimal(12, 2)

  /// {size: "XL", color: "red"}
  attributes Json @default("{}") @db.JsonB

  stock_quantity Int?
  is_active      Boolean @default(true)
  sort_order     Int     @default(0)
  image_url      String? @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses    @relation(fields: [business_id], references: [id], onDelete: Cascade)
  item     catalog_items @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, sku], map: "uq_variant_item_sku")
  @@index([business_id, item_id, is_active])
  @@map("catalog_variants")
}

/// Product bundles (multiple items sold together at a package price).
model catalog_packages {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  name        String  @db.VarChar(500)
  description String? @db.Text
  price       Decimal @db.Decimal(12, 2)
  is_active   Boolean @default(true)

  /// [{itemId, variantId?, quantity, label}]
  items    Json @default("[]") @db.JsonB
  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, is_active])
  @@map("catalog_packages")
}

/// A customer order (can span multiple items and shipments).
model orders {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id     String      @db.Uuid
  client_id       String      @db.Uuid
  conversation_id String?     @db.Uuid
  /// Human-readable: "ORD-2024-00123"
  order_number    String      @db.VarChar(50)
  status          OrderStatus @default(CONFIRMED)

  /// Line items snapshot — denormalized at order time
  line_items Json @db.JsonB

  subtotal        Decimal @db.Decimal(14, 2)
  discount_amount Decimal @default(0) @db.Decimal(14, 2)
  tax_amount      Decimal @default(0) @db.Decimal(14, 2)
  shipping_fee    Decimal @default(0) @db.Decimal(14, 2)
  total           Decimal @db.Decimal(14, 2)
  currency        String  @default("INR") @db.Char(3)

  discount_code  String?  @db.VarChar(50)
  /// PERCENT | FIXED
  discount_type  String?  @db.VarChar(20)
  discount_value Decimal? @db.Decimal(10, 2)

  shipping_address_id String? @db.Uuid
  shipping_option_id  String? @db.Uuid

  customer_note String? @db.Text
  internal_note String? @db.Text

  placed_at           DateTime  @default(now()) @db.Timestamptz
  confirmed_at        DateTime? @db.Timestamptz
  delivered_at        DateTime? @db.Timestamptz
  cancelled_at        DateTime? @db.Timestamptz
  cancellation_reason String?   @db.Text
  returned_at         DateTime? @db.Timestamptz
  return_reason       String?   @db.Text

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business         businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client           clients             @relation(fields: [client_id], references: [id])
  shipping_address shipping_addresses? @relation(fields: [shipping_address_id], references: [id])
  shipping_option  shipping_options?   @relation(fields: [shipping_option_id], references: [id])
  payments         payments[]
  shipments        shipments[]
  refunds          refunds[]

  @@unique([business_id, order_number])
  @@index([business_id, status, placed_at(sort: Desc)])
  @@index([business_id, client_id, status])
  @@index([client_id, placed_at(sort: Desc)])
  @@map("orders")
}

/// A payment record (one order can have multiple payment attempts).
model payments {
  id          String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String         @db.Uuid
  order_id    String?        @db.Uuid
  client_id   String         @db.Uuid
  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  gateway     PaymentGateway @default(RAZORPAY)

  /// Amount in rupees (Decimal for precision)
  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR") @db.Char(3)

  gateway_order_id   String? @db.VarChar(255)
  gateway_payment_id String? @db.VarChar(255)
  gateway_signature  String? @db.VarChar(500)

  payment_link_url        String?   @db.Text
  payment_link_id         String?   @db.VarChar(255)
  payment_link_expires_at DateTime? @db.Timestamptz

  initiated_at   DateTime? @db.Timestamptz
  captured_at    DateTime? @db.Timestamptz
  failed_at      DateTime? @db.Timestamptz
  failure_reason String?   @db.Text

  gateway_response Json @default("{}") @db.JsonB
  metadata         Json @default("{}") @db.JsonB

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  order    orders?    @relation(fields: [order_id], references: [id])
  client   clients    @relation(fields: [client_id], references: [id])
  refunds  refunds[]

  @@index([business_id, status, created_at(sort: Desc)])
  @@index([order_id])
  @@index([client_id])
  @@index([gateway_payment_id])
  @@index([gateway_order_id])
  // Payment-link webhooks look the payment up by link id, tenant unknown.
  @@index([payment_link_id])
  @@map("payments")
}

/// A refund against a payment.
model refunds {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String       @db.Uuid
  payment_id  String       @db.Uuid
  order_id    String?      @db.Uuid
  status      RefundStatus @default(INITIATED)
  amount      Decimal      @db.Decimal(14, 2)
  currency    String       @default("INR") @db.Char(3)

  reason String? @db.Text
  notes  String? @db.Text

  gateway_refund_id String? @db.VarChar(255)
  gateway_response  Json    @default("{}") @db.JsonB

  requires_approval Boolean   @default(false)
  approved_by       String?   @db.Uuid
  approved_at       DateTime? @db.Timestamptz
  rejected_by       String?   @db.Uuid
  rejected_at       DateTime? @db.Timestamptz
  rejection_reason  String?   @db.Text

  initiated_at DateTime  @default(now()) @db.Timestamptz
  completed_at DateTime? @db.Timestamptz
  failed_at    DateTime? @db.Timestamptz

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  payment  payments   @relation(fields: [payment_id], references: [id])
  order    orders?    @relation(fields: [order_id], references: [id])

  @@index([business_id, status, created_at(sort: Desc)])
  @@index([payment_id])
  @@index([order_id])
  // Refund webhooks arrive with only the gateway's refund id.
  @@index([gateway_refund_id])
  @@map("refunds")
}

/// A customer invoice. Standalone table (no FK relations) so the payment
/// module owns it without coupling to businesses/orders/clients models.
/// All monetary fields are stored in the currency's major unit (e.g. rupees)
/// as Decimal(14,2); convert to minor units (paise) only for business logic.
model invoices {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  order_id    String? @db.Uuid
  client_id   String  @db.Uuid
  payment_id  String? @db.Uuid

  /// Human-readable, per-business unique invoice number e.g. INV-2026-000123
  invoice_number String        @db.VarChar(50)
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("INR") @db.Char(3)

  subtotal        Decimal @db.Decimal(14, 2)
  tax_amount      Decimal @default(0) @db.Decimal(14, 2)
  discount_amount Decimal @default(0) @db.Decimal(14, 2)
  total           Decimal @db.Decimal(14, 2)

  /// Array of { description, quantity, unitAmountMinor, amountMinor }
  line_items Json    @default("[]") @db.JsonB
  notes      String? @db.Text

  issued_at DateTime? @db.Timestamptz
  due_at    DateTime? @db.Timestamptz
  paid_at   DateTime? @db.Timestamptz

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  @@unique([business_id, invoice_number])
  @@index([business_id, status, created_at(sort: Desc)])
  @@index([order_id])
  @@index([client_id])
  @@index([payment_id])
  @@map("invoices")
}

/// A customer shipping address.
model shipping_addresses {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  client_id   String  @db.Uuid
  /// "Home", "Work"
  label       String? @db.VarChar(50)
  is_default  Boolean @default(false)

  recipient_name String  @db.VarChar(255)
  line1          String  @db.VarChar(500)
  line2          String? @db.VarChar(500)
  city           String  @db.VarChar(100)
  state          String  @db.VarChar(100)
  pincode        String  @db.VarChar(20)
  country        String  @default("IN") @db.Char(2)
  phone          String? @db.VarChar(20)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business  businesses  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client    clients     @relation(fields: [client_id], references: [id], onDelete: Cascade)
  orders    orders[]
  shipments shipments[]

  @@index([client_id, is_default])
  @@index([business_id, client_id])
  @@map("shipping_addresses")
}

/// Available shipping options configured by a business.
model shipping_options {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  name        String  @db.VarChar(255)
  carrier     String? @db.VarChar(100)
  is_active   Boolean @default(true)

  base_fee                 Decimal  @db.Decimal(10, 2)
  per_kg_fee               Decimal  @default(0) @db.Decimal(10, 2)
  min_order_value_for_free Decimal? @db.Decimal(14, 2)

  min_days Int?
  max_days Int?

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business  businesses  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  orders    orders[]
  shipments shipments[]

  @@index([business_id, is_active])
  @@map("shipping_options")
}

/// A physical shipment for an order.
model shipments {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id         String         @db.Uuid
  order_id            String         @db.Uuid
  shipping_address_id String?        @db.Uuid
  shipping_option_id  String?        @db.Uuid
  status              ShipmentStatus @default(PENDING)
  carrier             String?        @db.VarChar(100)
  service_type        String?        @db.VarChar(100)

  /// "SHIPROCKET" | "DELHIVERY" | "MANUAL"
  provider             String? @db.VarChar(50)
  provider_shipment_id String? @db.VarChar(255)
  tracking_number      String? @db.VarChar(255)
  tracking_url         String? @db.Text
  /// Air Waybill for Shiprocket
  awb_code             String? @db.VarChar(100)

  weight_grams Int?
  /// {length, width, height}
  dimensions   Json? @db.JsonB

  shipping_cost Decimal? @db.Decimal(10, 2)

  estimated_delivery_at DateTime? @db.Timestamptz
  shipped_at            DateTime? @db.Timestamptz
  delivered_at          DateTime? @db.Timestamptz
  returned_at           DateTime? @db.Timestamptz

  /// [{status, location, description, timestamp}]
  tracking_events Json @default("[]") @db.JsonB

  notes    String? @db.Text
  metadata Json    @default("{}") @db.JsonB

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business         businesses          @relation(fields: [business_id], references: [id], onDelete: Cascade)
  order            orders              @relation(fields: [order_id], references: [id])
  shipping_address shipping_addresses? @relation(fields: [shipping_address_id], references: [id])
  shipping_option  shipping_options?   @relation(fields: [shipping_option_id], references: [id])

  @@index([business_id, status, created_at(sort: Desc)])
  @@index([order_id])
  @@index([tracking_number])
  @@index([provider_shipment_id])
  @@map("shipments")
}

/// A shopping cart — the staging area for items before an order is placed.
/// One ACTIVE cart per client at a time (enforced via a partial unique index in
/// migrations; here we keep a regular index for lookups).
model carts {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String     @db.Uuid
  client_id   String     @db.Uuid
  status      CartStatus @default(ACTIVE)

  /// Applied coupon (validated at apply time, re-validated at checkout)
  coupon_id      String?       @db.Uuid
  discount_code  String?       @db.VarChar(50)
  discount_type  DiscountType?
  discount_value Decimal?      @db.Decimal(10, 2)

  /// Set when the cart is converted into an order
  converted_order_id String?   @db.Uuid
  converted_at       DateTime? @db.Timestamptz

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses   @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client   clients      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  coupon   coupons?     @relation(fields: [coupon_id], references: [id])
  items    cart_items[]

  @@index([business_id, client_id, status])
  @@index([business_id, status])
  @@map("carts")
}

/// A single line in a shopping cart. Unlike order line items (which are an
/// immutable JSONB snapshot), cart items are live rows referencing the catalog.
model cart_items {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  cart_id     String  @db.Uuid
  item_id     String  @db.Uuid
  variant_id  String? @db.Uuid

  quantity Int @default(1)

  /// Price snapshot captured when the item was added (paise stored as rupees Decimal)
  unit_price Decimal @db.Decimal(12, 2)

  metadata Json @default("{}") @db.JsonB

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  cart     carts      @relation(fields: [cart_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, item_id, variant_id], map: "uq_cart_item_variant")
  @@index([business_id, cart_id])
  @@map("cart_items")
}

/// A discount coupon configured by a business.
model coupons {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String       @db.Uuid
  code        String       @db.VarChar(50)
  description String?      @db.VarChar(500)
  type        DiscountType @default(PERCENT)
  /// PERCENT: 0-100, FIXED: amount in rupees
  value       Decimal      @db.Decimal(10, 2)

  /// Minimum order subtotal (rupees) required to apply
  min_order_value Decimal? @db.Decimal(14, 2)
  /// Cap on the discount amount (rupees) for PERCENT coupons
  max_discount    Decimal? @db.Decimal(14, 2)

  /// Total times this coupon may be redeemed across all customers (null = unlimited)
  usage_limit      Int?
  /// Times this coupon may be redeemed by a single client (null = unlimited)
  per_client_limit Int?
  usage_count      Int  @default(0)

  valid_from  DateTime? @db.Timestamptz
  valid_until DateTime? @db.Timestamptz

  is_active Boolean @default(true)

  metadata Json @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  carts    carts[]

  @@unique([business_id, code])
  @@index([business_id, is_active])
  @@map("coupons")
}

/// A booking / appointment.
model bookings {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id     String        @db.Uuid
  client_id       String        @db.Uuid
  catalog_item_id String?       @db.Uuid
  status          BookingStatus @default(PENDING)

  start_at         DateTime @db.Timestamptz
  end_at           DateTime @db.Timestamptz
  timezone         String   @default("Asia/Kolkata") @db.VarChar(50)
  duration_minutes Int

  staff_id String? @db.Uuid

  /// Links this occurrence to a recurring series (booking_recurrences.id). Null = one-off.
  recurrence_id String? @db.Uuid

  /// "IN_PERSON" | "ONLINE" | "HOME_VISIT"
  location_type    String? @db.VarChar(20)
  location_address String? @db.Text
  meeting_url      String? @db.Text

  gcal_event_id    String? @db.VarChar(255)
  gcal_calendar_id String? @db.VarChar(255)

  price          Decimal? @db.Decimal(12, 2)
  deposit_amount Decimal? @db.Decimal(12, 2)
  payment_id     String?  @db.Uuid

  reminders_sent   Int       @default(0)
  last_reminder_at DateTime? @db.Timestamptz

  cancelled_at        DateTime? @db.Timestamptz
  cancellation_reason String?   @db.Text
  /// "CLIENT" | "BUSINESS" | "SYSTEM"
  cancelled_by        String?   @db.VarChar(20)

  notes    String? @db.Text
  metadata Json    @default("{}") @db.JsonB

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  business businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  client   clients    @relation(fields: [client_id], references: [id])

  @@index([business_id, status, start_at])
  @@index([business_id, client_id])
  @@index([business_id, staff_id, start_at])
  @@index([business_id, recurrence_id])
  @@index([gcal_event_id])
  @@map("bookings")
}

/// Weekly availability template for a business (or a specific staff member).
/// Slots are computed dynamically from this template minus blocks and existing
/// bookings — there are no pre-generated slot rows.
model booking_availability {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  /// Null = business-wide default schedule; set = per-staff override.
  staff_id    String? @db.Uuid

  /// IANA timezone the weekly_hours are expressed in.
  timezone String @default("Asia/Kolkata") @db.VarChar(50)

  /// Recurring weekly windows: [{ dayOfWeek: 0-6 (0=Sun), startMinute, endMinute }]
  /// startMinute/endMinute are minutes from local midnight.
  weekly_hours Json @default("[]") @db.JsonB

  /// Granularity at which candidate slot start times are generated.
  slot_interval_minutes Int @default(30)
  /// Gap enforced after each booking before the next can start.
  buffer_minutes        Int @default(0)
  /// Minimum lead time before a slot can be booked.
  min_notice_minutes    Int @default(120)
  /// How far ahead bookings are allowed.
  max_advance_days      Int @default(60)
  /// Concurrent bookings allowed per slot (e.g. number of chairs/rooms).
  capacity_per_slot     Int @default(1)

  is_active  Boolean   @default(true)
  metadata   Json      @default("{}") @db.JsonB
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  @@unique([business_id, staff_id])
  @@index([business_id, is_active])
  @@map("booking_availability")
}

/// One-off blocked time ranges (holidays, breaks, leave) that remove slots from
/// availability. Scoped to a business and optionally a single staff member.
model booking_blocked_slots {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  /// Null = applies to the whole business; set = only that staff member.
  staff_id    String? @db.Uuid

  start_at DateTime @db.Timestamptz
  end_at   DateTime @db.Timestamptz
  reason   String?  @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  @@index([business_id, start_at, end_at])
  @@index([business_id, staff_id, start_at])
  @@map("booking_blocked_slots")
}

/// OAuth connection + token store for syncing bookings to an external calendar
/// (Google Calendar). One per business (optionally per staff) per provider.
model booking_calendar_connections {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id String  @db.Uuid
  staff_id    String? @db.Uuid

  provider             String  @default("google") @db.VarChar(20)
  google_calendar_id   String? @db.VarChar(255)
  google_account_email String? @db.VarChar(320)

  /// Encrypted at rest in production. Refreshed silently when expired.
  access_token     String?   @db.Text
  refresh_token    String?   @db.Text
  token_expires_at DateTime? @db.Timestamptz
  scope            String?   @db.Text

  sync_enabled    Boolean   @default(true)
  last_synced_at  DateTime? @db.Timestamptz
  last_sync_error String?   @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  @@unique([business_id, staff_id, provider])
  @@index([business_id, sync_enabled])
  @@map("booking_calendar_connections")
}

/// Definition of a recurring appointment series. Individual occurrences are
/// materialised as `bookings` rows whose `recurrence_id` points here.
model booking_recurrences {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  business_id     String  @db.Uuid
  client_id       String  @db.Uuid
  catalog_item_id String? @db.Uuid
  staff_id        String? @db.Uuid

  /// { frequency: 'DAILY'|'WEEKLY'|'MONTHLY', interval, count?, until?, byWeekday?: number[] }
  rule Json @db.JsonB

  /// Anchor of the first occurrence (UTC instant).
  start_at         DateTime @db.Timestamptz
  duration_minutes Int
  timezone         String   @default("Asia/Kolkata") @db.VarChar(50)

  /// "IN_PERSON" | "ONLINE" | "HOME_VISIT"
  location_type    String?  @db.VarChar(20)
  location_address String?  @db.Text
  meeting_url      String?  @db.Text
  price            Decimal? @db.Decimal(12, 2)
  notes            String?  @db.Text

  is_active  Boolean   @default(true)
  metadata   Json      @default("{}") @db.JsonB
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  deleted_at DateTime? @db.Timestamptz

  @@index([business_id, is_active])
  @@index([business_id, client_id])
  @@map("booking_recurrences")
}

// ─────────────────────────────────────────────
// ENGAGEMENT LAYER
