# Base URL of the GoSumo NestJS API (without the /v1 suffix — the client appends it).
# Production: https://api.gosumo.doaide.com  (legacy: api.gosumo.aiknol.com)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Base URL of the Socket.IO / WebSocket server. Usually the same host as the API.
# Production: https://api.gosumo.doaide.com  (legacy: api.gosumo.aiknol.com)
NEXT_PUBLIC_WS_URL=http://localhost:3000
