# ============================================================
# GoSumo API — Environment Configuration Template
# Copy this file to .env and fill in values before running.
# Never commit .env to version control.
# ============================================================

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# Swagger UI (GET /v1/docs). Mounted automatically whenever NODE_ENV is not
# "production". In production it is left unmounted, because it publishes every
# route, DTO and example the API has — a free reconnaissance map — and the
# dashboard does not use it. Set this to the exact string "true" to serve it in
# production anyway; any other value (including "1") leaves it off.
# ENABLE_SWAGGER=true

# PostgreSQL
DATABASE_URL=postgresql://gosumo:gosumo@localhost:5432/gosumo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_EXPIRATION=7d

# OpenRouter — LLM provider (free models, e.g. openai/gpt-oss-20b:free)
OPENROUTER_API_KEY=
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_REFERER=https://gosumo.aiknol.com
# OPENROUTER_TITLE=GoSumo

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# Meta / WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta / Instagram Messaging API
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# Inbound webhook secrets for channels whose provider has no signature scheme
# of its own. POST /webhooks/:channel is public, so an unset secret here means
# the adapter rejects every call in production (and warns in dev). The relay
# sends HMAC-SHA256(rawBody, secret) as hex in the x-gosumo-signature header.
EMAIL_INBOUND_WEBHOOK_SECRET=
WEBCHAT_INBOUND_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS S3
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
