# ============================================================
# GoSumo API — Environment Configuration Template
# Copy this file to .env and fill in values before running.
# Never commit .env to version control.
# ============================================================

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000

# Sites allowed to embed the web-chat widget (comma-separated), for the
# /webchat socket namespace only. Unset means any origin, with credentials
# switched off — `Access-Control-Allow-Origin: *` plus credentials is the one
# combination browsers refuse. Name the origins to get credentials back.
# WEBCHAT_ALLOWED_ORIGINS=https://shop.example,https://www.shop.example

# Absolute base URL this API is reachable at. Used to build the callback and
# media URLs handed to external providers, so a wrong value here produces links
# that resolve to nothing from the outside. API_URL wins if both are set.
# API_URL=http://localhost:3000
# API_BASE_URL=http://localhost:3000

# Dashboard origin. OAuth redirects and password-reset links point here — it is
# where the *user* lands, which is not necessarily where CORS_ORIGIN points.
# FRONTEND_URL=http://localhost:3001

# Swagger UI (GET /v1/docs). Mounted automatically whenever NODE_ENV is not
# "production". In production it is left unmounted, because it publishes every
# route, DTO and example the API has — a free reconnaissance map — and the
# dashboard does not use it. Set this to the exact string "true" to serve it in
# production anyway; any other value (including "1") leaves it off.
# ENABLE_SWAGGER=true

# PostgreSQL
DATABASE_URL=postgresql://gosumo:gosumo@localhost:5432/gosumo_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRATION=7d

# Channel-credential encryption (AES-256-GCM over the `credentials` JSONB on
# channel_accounts). SET THIS IN PRODUCTION — `openssl rand -base64 48`.
#
# Checked at startup. With NODE_ENV=production the API refuses to boot if this
# and JWT_SECRET are both unset, because the key would then come from a constant
# committed to this repository — which is to say, from no encryption at all.
# Falling back to JWT_SECRET boots with a warning.
#
# It is also the key rotation boundary, and rotation is silent: changing it (or
# changing JWT_SECRET while this is unset) makes every stored credential
# undecryptable, and decryption failure returns an empty object rather than an
# error. Nothing will report it — re-enter channel credentials after rotating.
CHANNEL_ENCRYPTION_KEY=

# Google OAuth (the "Sign in with Google" flow). Unset disables that flow;
# email/password login is unaffected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OpenRouter — LLM provider (free models, e.g. openai/gpt-oss-20b:free)
OPENROUTER_API_KEY=
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_REFERER=https://gosumo.doaide.com  # (legacy: gosumo.aiknol.com)
# OPENROUTER_TITLE=GoSumo

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# Speech-to-text for WhatsApp voice notes. Any OpenAI-compatible
# /audio/transcriptions endpoint (OpenRouter, Groq Whisper, self-hosted).
# The key falls back to OPENROUTER_API_KEY; with neither set the transcriber
# runs in simulation mode and voice notes are never transcribed.
# TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1

# GoSumo Realty ingress. Each of these authenticates a public endpoint, so an
# unset one leaves that endpoint open or failing closed — never merely degraded.
# IVR_WEBHOOK_SECRET verifies the HMAC on the missed-call → WhatsApp webhook,
# REALTY_PORTAL_INGEST_TOKEN gates the portal enquiry webhook, and
# REALTY_META_LEADGEN_VERIFY_TOKEN answers Meta's GET challenge.
# IVR_WEBHOOK_SECRET=
# REALTY_PORTAL_INGEST_TOKEN=
# REALTY_META_LEADGEN_VERIFY_TOKEN=
# IVR_GREETING=

# Meta / WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Meta / Instagram Messaging API
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=

# Inbound webhook secrets for channels whose provider has no signature scheme
# of its own. POST /webhooks/:channel is public, so an unset secret here means
# the adapter rejects every call in production (and warns in dev). The relay
# sends HMAC-SHA256(rawBody, secret) as hex in the x-gosumo-signature header.
EMAIL_INBOUND_WEBHOOK_SECRET=
WEBCHAT_INBOUND_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS S3
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Notification providers (order confirmations, reminders, alerts). Each channel
# is independent: with a provider's credentials absent the dispatcher runs that
# channel in simulation mode — it logs the send and returns a synthetic message
# id, so the rest of the pipeline works but nothing reaches the customer.
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@gosumo.app
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=GOSUMO
# FCM_API_URL=https://fcm.googleapis.com/fcm/send
# FCM_SERVER_KEY=
